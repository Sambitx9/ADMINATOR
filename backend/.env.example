# ADMINATOR Backend Environment Configuration
# Mode: Local ₹0 Cost Foundation / Cloud Production Compatible
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# - Development: Local MongoDB Community Edition
# - Production: Cloud MongoDB Atlas connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/adminator)
MONGODB_URI=mongodb://127.0.0.1:27017/adminator_demo

# Security & Authentication (Required: minimum 32 random characters in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=8h

# Demo Staff Seeding (Security Invariant: Strictly prohibited in production)
# Set to 'true' only in local development to seed demo staff accounts.
SEED_DEMO_STAFF=false
DEMO_STAFF_PASSWORD=

# Deterministic Intelligence & AI Gateway (Zero Cost Default)
# AI_PROVIDER options: 'deterministic' (default ₹0) | 'gemini' (requires free tier GEMINI_API_KEY)
AI_PROVIDER=deterministic
GEMINI_API_KEY=

# Automation & Webhook Dispatcher
# AUTOMATION_ENGINE options: 'local' (default in-process ₹0) | 'n8n' (webhook poster)
AUTOMATION_ENGINE=local
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
